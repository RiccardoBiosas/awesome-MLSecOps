---
import { getCollection } from "astro:content";
import type { Graph } from "schema-dts";
import NewsletterCta from "../components/NewsletterCta.astro";
// import SponsorRow from "../components/SponsorRow.astro";
import StructuredData from "../components/StructuredData.astro";
import { CONTRIBUTE_URL, MLSECOPS_DEFINITION_LEAD, MLSECOPS_DEFINITION_SUPPORT, NEWSLETTER_NAME, REPOSITORY_URL, SITE_URL, subscribeUrl } from "../config/site";
import { sortIssues } from "../lib/newsletterFeed";
import { TOOL_CATEGORIES } from "../data/categories";
import BaseLayout from "../layouts/BaseLayout.astro";

const tools = await getCollection("tools");
const counts = new Map(TOOL_CATEGORIES.map((category) => [category.id, tools.filter((tool) => tool.data.category === category.id).length]));
const latestIssues = sortIssues(await getCollection("newsletter")).slice(0, 5);
const formatDate = (date: Date) => new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" }).format(date);

const schema: Graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${SITE_URL}/#page`,
      url: SITE_URL,
      name: "Awesome MLSecOps",
      description: "A citation-friendly guide to MLSecOps, machine learning security, AI security tools, jobs, and research.",
    },
    {
      "@type": "ItemList",
      name: "MLSecOps tool categories",
      numberOfItems: TOOL_CATEGORIES.length,
      itemListElement: TOOL_CATEGORIES.map((category, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: category.name,
        url: `${SITE_URL}/tools/${category.id}/`,
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${SITE_URL}/#latest-articles`,
      name: `Latest articles from ${NEWSLETTER_NAME}`,
      numberOfItems: latestIssues.length,
      itemListElement: latestIssues.map((issue, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: issue.data.title,
        url: issue.data.link,
        item: {
          "@type": "BlogPosting",
          headline: issue.data.title,
          url: issue.data.link,
          datePublished: issue.data.date.toISOString().slice(0, 10),
          description: issue.data.summary,
        },
      })),
    },
    {
      "@type": "SoftwareSourceCode",
      name: "Awesome MLSecOps",
      codeRepository: REPOSITORY_URL,
      programmingLanguage: "Markdown",
      license: `${REPOSITORY_URL}/blob/main/LICENSE`,
      description: "The community-maintained source catalog for Awesome MLSecOps.",
    },
  ],
};
---

<BaseLayout
  title="Awesome MLSecOps | ML & AI Security Resources"
  description="MLSecOps tools and guidance for machine learning security, MLOps security, LLM security, threat modeling, jobs, and AI red teaming."
  ogKey="home"
>
  <StructuredData data={schema} />
  <section class="page-hero hub-hero">
    <div class="shell">
      <p class="eyebrow">The Machine Learning Security Atlas</p>
      <h1>Awesome MLSecOps — Curated ML & AI Security Tools and Resources</h1>
      <p class="definition"><strong>{MLSECOPS_DEFINITION_LEAD}</strong> {MLSECOPS_DEFINITION_SUPPORT}</p>
      <div class="button-row">
        <a class="button" href={REPOSITORY_URL} data-analytics-event="Repo Outbound">Star the catalog on GitHub</a>
        <a class="button-secondary" href={CONTRIBUTE_URL} data-analytics-event="Repo Outbound">Contribute a resource</a>
      </div>
      <NewsletterCta aboveFold compact />
    </div>
  </section>

  <section class="content-section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Browse by security problem</p>
        <h2>Focused guides, one community source</h2>
        <p>Browse MLSecOps tools and resources by machine learning security category. The GitHub repository contains the complete, community-maintained catalog.</p>
      </div>
      <div class="category-grid">
        {TOOL_CATEGORIES.map((category) => (
          <a class="category-card" href={`/tools/${category.id}/`}>
            <span class="count">{counts.get(category.id) ?? 0} catalog entries</span>
            <h3>{category.name}</h3>
            <p>{category.shortDescription}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="content-section" aria-labelledby="latest-articles-title">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Newsletter</p>
        <h2 id="latest-articles-title">Latest from {NEWSLETTER_NAME}</h2>
        <p>Articles on MLSecOps tooling, AI supply-chain security, prompt injection, and agent security, published first on the maintainer's newsletter.</p>
      </div>
      <ol class="article-list">
        {latestIssues.map((issue) => (
          <li class="article-item">
            <time datetime={issue.data.date.toISOString()}>{formatDate(issue.data.date)}</time>
            <h3><a href={issue.data.link} data-analytics-event="Newsletter Issue Outbound">{issue.data.title}</a></h3>
            <p>{issue.data.summary}</p>
          </li>
        ))}
      </ol>
      <div class="button-row">
        <a class="button" href={subscribeUrl("home-latest")} data-analytics-event="Newsletter Signup">Subscribe</a>
        <a class="button-secondary" href="/newsletter/">Full archive</a>
      </div>
    </div>
  </section>

  <section class="content-section">
    <div class="shell metric-grid">
      <div class="metric"><strong>{tools.length}</strong><span>synced tool entries</span></div>
      <div class="metric"><strong>6</strong><span>security category guides</span></div>
      <div class="metric"><strong>1</strong><span>community-maintained source</span></div>
    </div>
  </section>

  {/* Sponsorship is temporarily disabled.
  <section class="content-section">
    <div class="shell"><SponsorRow /></div>
  </section>
  */}
</BaseLayout>